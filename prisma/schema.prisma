generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdAnalysis {
  id          String   @id @default(cuid())
  query       String
  companyName String
  domain      String
  totalAds    Int
  volumeScore Int
  createdAt   DateTime @default(now())
}
